#!/bin/bash
#
# LCD35-show-pi4b -- set up a 3.5" ILI9486 SPI touchscreen (ADS7846 resistive
# touch) on a Raspberry Pi 4 Model B running Raspberry Pi OS Trixie.
#
#     sudo ./LCD35-show-pi4b                     # install with defaults
#     sudo ./LCD35-show-pi4b --speed 32000000    # push the SPI clock
#     sudo ./LCD35-show-pi4b --transform 90      # different screen rotation
#     sudo ./LCD35-show-pi4b --uninstall         # take it all back out
#
# This is a ground-up rewrite. It shares nothing but a name with the original
# LCD35-show, which was written for Buster/Bullseye and does not work here:
#
#   * fbcp mirrored the HDMI output onto the panel using dispmanx, which
#     Raspberry Pi removed in Bookworm. fbcp cannot even be compiled on Trixie.
#   * The legacy hdmi_group / hdmi_cvt / hdmi_drive keys it wrote are ignored
#     under KMS, so forcing HDMI to 480x320 does nothing.
#   * It swapped the KMS driver for the deprecated fkms one. On Trixie fkms
#     loads but finds no display at all, leaving the Pi with no framebuffer.
#
# Instead this drives the panel as a real DRM/KMS display via the in-tree
# piscreen overlay, so it is a genuine screen the compositor can draw to
# rather than a copy of something else. Nothing else on the system needs to
# change -- in particular vc4-kms-v3d is left alone, so HDMI keeps working.
#
# Everything it needs either ships with Raspberry Pi OS (the piscreen overlay)
# or comes from apt (wlr-randr). There are no companion files to download.

set -u

# --- defaults ---------------------------------------------------------------

# SPI clock. A full 320x480 16-bit frame is ~2.5 Mbit, so 16 MHz gives about
# 6-7 fps and 32 MHz roughly doubles it. Most of these boards are happy at
# 32 MHz, some reach 48 or 64. If you see speckled noise, torn rows, flicker
# or a dark panel, step back down a notch -- there is no damage risk in
# trying a speed that is too high.
SPEED=16000000

# Screen rotation, passed to wlr-randr. The panel is natively portrait, so
# 90 and 270 give the two landscape orientations.
TRANSFORM=180

# libinput calibration matrix mapping raw touch coordinates onto the rotated
# screen. Least-squares fit over four averaged corner presses on the workshop
# unit. If you change TRANSFORM you must re-measure this -- see "Recalibrating
# the touchscreen" in the README.
MATRIX="-1.190 0 1.091 0 1.187 -0.094"

DO_REBOOT=ask
UNINSTALL=no
TARGET_USER=""

BEGIN_MARK="# --- LCD35-show-pi4b begin ---"
END_MARK="# --- LCD35-show-pi4b end ---"
UDEV_RULE=/etc/udev/rules.d/99-touchscreen-calibration.rules

red()  { echo -e "\033[31m$*\033[0m"; }
warn() { echo -e "\033[33m$*\033[0m"; }
ok()   { echo -e "\033[32m$*\033[0m"; }

die()  { red "$*"; exit 1; }

usage() {
    sed -n '3,26p' "$0" | sed 's/^# \?//'
    cat <<EOF

Options:
  --speed HZ         SPI clock for the panel (default $SPEED)
  --transform DEG    Screen rotation: 0, 90, 180 or 270 (default $TRANSFORM)
  --matrix "a b c d e f"
                     libinput calibration matrix for the touchscreen
  --user NAME        Which user's desktop config to write (default: the user
                     who ran sudo)
  --reboot           Reboot when finished without asking
  --no-reboot        Do not reboot, just print what to do next
  --uninstall        Remove everything this script installs
  -h, --help         Show this help
EOF
}

# --- arguments --------------------------------------------------------------

while [ $# -gt 0 ]; do
    case "$1" in
        --speed)      SPEED=${2:-}; shift 2 ;;
        --transform)  TRANSFORM=${2:-}; shift 2 ;;
        --matrix)     MATRIX=${2:-}; shift 2 ;;
        --user)       TARGET_USER=${2:-}; shift 2 ;;
        --reboot)     DO_REBOOT=yes; shift ;;
        --no-reboot)  DO_REBOOT=no; shift ;;
        --uninstall)  UNINSTALL=yes; shift ;;
        -h|--help)    usage; exit 0 ;;
        *)            red "unknown option: $1"; echo; usage; exit 1 ;;
    esac
done

case "$TRANSFORM" in
    0|90|180|270) ;;
    *) die "--transform must be 0, 90, 180 or 270 (got '$TRANSFORM')" ;;
esac

case "$SPEED" in
    ''|*[!0-9]*) die "--speed must be a number in Hz, e.g. 32000000 (got '$SPEED')" ;;
esac

if [ "$(echo "$MATRIX" | wc -w)" -ne 6 ]; then
    die "--matrix needs exactly six numbers (got '$MATRIX')"
fi

# The default matrix was fitted at transform 180. Rotating the screen without
# re-measuring leaves touch mapped to the old orientation, which is the most
# confusing failure mode there is: the panel looks right and the taps do not.
if [ "$TRANSFORM" != 180 ] && [ "$MATRIX" = "-1.190 0 1.091 0 1.187 -0.094" ]; then
    warn "The built-in calibration matrix was measured at --transform 180."
    warn "At --transform $TRANSFORM your taps will land in the wrong place until"
    warn "you re-measure it -- see \"Recalibrating the touchscreen\" in the README."
    read -r -p "Continue anyway? [y/N] " reply
    case "$reply" in [yY]*) ;; *) echo "stopping"; exit 1 ;; esac
fi

# --- pre-flight -------------------------------------------------------------
#
# Every check that can fail happens here, before anything on disk is touched.
# The first version of this script edited config.txt and then discovered its
# other dependencies were missing, which left the Pi with a blank screen and
# no way to see what had gone wrong. Nothing below this block is allowed to
# fail halfway.

[ "$(id -u)" -eq 0 ] || die "run this with sudo: sudo $0"

model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)
echo "board:  ${model:-unknown}"
case "$model" in
    *"Raspberry Pi 4"*) ;;
    *) warn "This was written and tested on a Raspberry Pi 4 Model B."
       warn "Other boards may need a different overlay or pin mapping."
       read -r -p "Continue anyway? [y/N] " reply
       case "$reply" in [yY]*) ;; *) echo "stopping"; exit 1 ;; esac ;;
esac

if [ -f /boot/firmware/config.txt ]; then
    BOOT_DIR=/boot/firmware
elif [ -f /boot/config.txt ]; then
    BOOT_DIR=/boot
else
    die "cannot find config.txt -- is this Raspberry Pi OS?"
fi
CONFIG_TXT=$BOOT_DIR/config.txt
echo "config: $CONFIG_TXT"

deb_version=$(cat /etc/debian_version 2>/dev/null)
deb_major=${deb_version%%.*}
echo "debian: ${deb_version:-unknown}"
if [ "${deb_major:-0}" -lt 12 ] 2>/dev/null; then
    warn "This targets Trixie (Debian 13). On Bullseye or older the original"
    warn "LCD-show approach is the one that works -- this script is not it."
    read -r -p "Continue anyway? [y/N] " reply
    case "$reply" in [yY]*) ;; *) echo "stopping"; exit 1 ;; esac
fi

# Which user's desktop config are we writing? Not root's.
if [ -z "$TARGET_USER" ]; then
    TARGET_USER=${SUDO_USER:-}
fi
[ -n "$TARGET_USER" ] || die "cannot tell which user to configure -- pass --user NAME"
USER_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
[ -n "$USER_HOME" ] && [ -d "$USER_HOME" ] || die "no home directory for user '$TARGET_USER'"
echo "user:   $TARGET_USER ($USER_HOME)"

if [ "$UNINSTALL" = no ]; then
    [ -f "$BOOT_DIR/overlays/piscreen.dtbo" ] \
        || die "$BOOT_DIR/overlays/piscreen.dtbo is missing -- this overlay ships with Raspberry Pi OS, so something is wrong with the install"
fi

echo

# --- uninstall --------------------------------------------------------------

strip_config_block() {
    # Matches this script's marker and the one the first version wrote.
    sed -i '\|^# --- LCD35-show-pi4b begin|,\|^# --- LCD35-show-pi4b end ---$|d' "$CONFIG_TXT"
}

if [ "$UNINSTALL" = yes ]; then
    cp -f "$CONFIG_TXT" "$CONFIG_TXT.lcd35-pi4b.bak"
    strip_config_block
    rm -f "$UDEV_RULE"
    autostart=$USER_HOME/.config/labwc/autostart
    [ -f "$autostart" ] && sed -i '/LCD35-show-pi4b/d' "$autostart"
    ok "removed the config block, the udev rule and the autostart line"
    echo "a copy of the previous config.txt is at $CONFIG_TXT.lcd35-pi4b.bak"
    echo "reboot to finish backing it out"
    exit 0
fi

# --- config.txt -------------------------------------------------------------

cp -f "$CONFIG_TXT" "$CONFIG_TXT.lcd35-pi4b.bak"
echo "backed up config.txt to $CONFIG_TXT.lcd35-pi4b.bak"

# The first version of this script commented this line out to make room for
# the deprecated fkms driver, which on Trixie leaves the Pi with no display
# driver at all. If a previous run did that, put it back.
if grep -qE '^[[:space:]]*#[[:space:]]*dtoverlay=vc4-kms-v3d' "$CONFIG_TXT"; then
    warn "vc4-kms-v3d was commented out -- re-enabling it (the panel does not need it disabled)"
    sed -i 's/^[[:space:]]*#[[:space:]]*dtoverlay=vc4-kms-v3d/dtoverlay=vc4-kms-v3d/' "$CONFIG_TXT"
fi

strip_config_block

cat >> "$CONFIG_TXT" <<EOF
$BEGIN_MARK
[all]
dtparam=spi=on

# 3.5" ILI9486 panel as a real DRM/KMS display. drm=1 selects the in-kernel
# ili9486 driver rather than the staging fbtft one, which is what lets a
# Wayland compositor treat it as a display instead of a dumb framebuffer.
dtoverlay=piscreen,drm=1,speed=$SPEED
$END_MARK
EOF
ok "wrote the panel overlay into $CONFIG_TXT"

# --- touchscreen calibration ------------------------------------------------
#
# The piscreen overlay advertises swapxy / invx / invy parameters for the
# touch panel, but on Trixie they have no effect -- measured raw coordinates
# are identical with and without them. Rotating the touch input in userspace
# with a libinput calibration matrix does work, so that is what we use.
#
# Note that evtest always shows the raw, uncalibrated numbers: the matrix is
# applied by libinput further up the stack. Test the calibration by using the
# desktop, not by reading evtest.

cat > "$UDEV_RULE" <<EOF
# ADS7846 touch mapping for the 3.5" panel at --transform $TRANSFORM.
# Least-squares fit over four averaged corner presses.
SUBSYSTEM=="input", ATTRS{name}=="ADS7846 Touchscreen", ENV{LIBINPUT_CALIBRATION_MATRIX}="$MATRIX"
EOF
ok "wrote the touch calibration to $UDEV_RULE"

# --- screen rotation --------------------------------------------------------

if ! command -v wlr-randr > /dev/null 2>&1; then
    echo "installing wlr-randr..."
    if ! apt-get install -y wlr-randr > /dev/null 2>&1; then
        warn "could not install wlr-randr -- the panel will come up portrait."
        warn "run 'sudo apt install wlr-randr' once you have a network and re-run this."
    fi
fi

# labwc uses ~/.config/labwc/autostart INSTEAD of the system one when it
# exists, so seed it from the system copy first. Skipping this step loses the
# taskbar and desktop icons.
AUTOSTART_DIR=$USER_HOME/.config/labwc
AUTOSTART=$AUTOSTART_DIR/autostart
mkdir -p "$AUTOSTART_DIR"
if [ ! -f "$AUTOSTART" ] && [ -f /etc/xdg/labwc/autostart ]; then
    cp /etc/xdg/labwc/autostart "$AUTOSTART"
    echo "seeded $AUTOSTART from the system default"
fi
touch "$AUTOSTART"
sed -i '/LCD35-show-pi4b/d' "$AUTOSTART"
echo "wlr-randr --output SPI-1 --transform $TRANSFORM &  # LCD35-show-pi4b" >> "$AUTOSTART"
chown -R "$TARGET_USER": "$AUTOSTART_DIR"
ok "set the panel to --transform $TRANSFORM on login ($AUTOSTART)"

# --- done -------------------------------------------------------------------

sync
echo
echo "Installed:"
echo "  panel      ILI9486 over SPI at $SPEED Hz, as a DRM display"
echo "  rotation   transform $TRANSFORM, applied at login"
echo "  touch      libinput matrix $MATRIX"
echo
echo "After rebooting, check that:"
echo "  * the desktop appears on the panel, already the right way up"
echo "  * taps land where you press, especially near the corners"
echo "  * HDMI still works if you plug a monitor in"
echo
echo "If the panel shows speckled noise or torn rows, the SPI clock is too"
echo "high for your board -- re-run with a lower --speed."
echo
echo "To undo everything: sudo $0 --uninstall"
echo

case "$DO_REBOOT" in
    yes) echo "rebooting"; reboot ;;
    no)  echo "reboot when you are ready for the changes to take effect" ;;
    *)   read -r -p "Reboot now? [y/N] " reply
         case "$reply" in
             [yY]*) echo "rebooting"; reboot ;;
             *) echo "reboot when you are ready for the changes to take effect" ;;
         esac ;;
esac
